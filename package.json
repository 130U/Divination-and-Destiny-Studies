{
  "name": "divination-and-destiny-studies",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local BaZi charts and DeepSeek analysis with optional personal context.",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test tests/*.test.ts",
    "check:type": "tsc --noEmit",
    "build:web": "node scripts/build-web.ts",
    "test:web:live": "node --env-file-if-exists=.env scripts/live-web-smoke.ts",
    "check": "npm run check:type && npm test && node scripts/check-vendor.ts",
    "test:live": "node --env-file-if-exists=.env scripts/live-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  }
}
