{
  "name": "divination-and-destiny-studies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Questionnaire-first BaZi chart review with local calculation and DeepSeek.",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.ts",
